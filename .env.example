APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://cartoon:cartoon@postgres:5432/cartoon_studio
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/workspace/storage
RENDER_PATH=/workspace/renders

# Self-hosted LLM endpoint. Works with vLLM, llama.cpp, or compatible local servers.
LLM_PROVIDER=local-openai-compatible
LLM_BASE_URL=
LLM_API_KEY=change-this-private-token
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_JSON_RESPONSE_FORMAT=true

# Self-hosted image endpoint. Start ComfyUI on Lightning, Colab, or a local GPU.
IMAGE_PROVIDER=local-comfyui
IMAGE_BASE_URL=
IMAGE_WORKFLOW_PATH=/workspace/workflows/comfyui/sdxl.json
IMAGE_REFERENCE_WORKFLOW_PATH=/workspace/workflows/comfyui/sdxl_ipadapter.json
IMAGE_CLIENT_ID=ai-cartoon-studio
IMAGE_TIMEOUT_SECONDS=600
IMAGE_POLL_INTERVAL_SECONDS=2

# Animation provider. Keep local-comfyui-video for legacy image-to-video shots.
# Set VIDEO_PROVIDER=local-blender for permanent scenes, rigs, actions, cameras, and props.
VIDEO_PROVIDER=local-comfyui-video
VIDEO_BASE_URL=
VIDEO_WORKFLOW_PATH=/workspace/workflows/comfyui/svd.json
VIDEO_CLIENT_ID=ai-cartoon-studio-video
VIDEO_TIMEOUT_SECONDS=1200
VIDEO_POLL_INTERVAL_SECONDS=3

BLENDER_BINARY=blender
BLENDER_RUNNER_SCRIPT=/workspace/workers/blender/shot_executor.py
BLENDER_JOBS_PATH=/workspace/renders/blender-jobs
BLENDER_TIMEOUT_SECONDS=1800

# Self-hosted TTS endpoint using an OpenAI-compatible /v1/audio/speech API.
VOICE_PROVIDER=local-openai-compatible-tts
VOICE_BASE_URL=
VOICE_API_KEY=change-this-private-token
VOICE_MODEL=local-tts
VOICE_TIMEOUT_SECONDS=300
VOICE_MAX_RETRIES=2

# Self-hosted MuseTalk, Wav2Lip, or compatible wrapper.
# POST /v1/lip-sync receives one video, audio_0..N files, and a JSON manifest.
LIP_SYNC_PROVIDER=local-lip-sync-http
LIP_SYNC_BASE_URL=
LIP_SYNC_ENDPOINT_PATH=/v1/lip-sync
LIP_SYNC_API_KEY=change-this-private-token
LIP_SYNC_TIMEOUT_SECONDS=1200

# Self-hosted ambience, effects, and music generation endpoint.
SOUND_PROVIDER=local-sound-http
SOUND_BASE_URL=
SOUND_ENDPOINT_PATH=/v1/audio/generate
SOUND_API_KEY=change-this-private-token
SOUND_TIMEOUT_SECONDS=600
SOUND_MAX_RETRIES=2
FFMPEG_BINARY=ffmpeg

CELERY_TASK_ALWAYS_EAGER=false
