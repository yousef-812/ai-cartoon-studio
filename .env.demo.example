APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://cartoon:cartoon@postgres:5432/cartoon_studio
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/workspace/storage
RENDER_PATH=/workspace/renders

# Qwen3 llama.cpp server. Replace host.docker.internal with a public tunnel URL when using a remote GPU.
LLM_PROVIDER=local-openai-compatible
LLM_BASE_URL=http://host.docker.internal:8080
LLM_API_KEY=demo-llm-token
LLM_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2
LLM_JSON_RESPONSE_FORMAT=true

# One ComfyUI host serves SDXL, IP-Adapter SDXL, and SVD workflows.
IMAGE_PROVIDER=local-comfyui
IMAGE_BASE_URL=http://host.docker.internal:8188
IMAGE_WORKFLOW_PATH=/workspace/workflows/comfyui/sdxl.json
IMAGE_REFERENCE_WORKFLOW_PATH=/workspace/workflows/comfyui/sdxl_ipadapter.json
IMAGE_CLIENT_ID=first-real-episode-images
IMAGE_TIMEOUT_SECONDS=1200
IMAGE_POLL_INTERVAL_SECONDS=3

VIDEO_PROVIDER=local-comfyui-video
VIDEO_BASE_URL=http://host.docker.internal:8188
VIDEO_WORKFLOW_PATH=/workspace/workflows/comfyui/svd_demo_6fps.json
VIDEO_CLIENT_ID=first-real-episode-video
VIDEO_TIMEOUT_SECONDS=2400
VIDEO_POLL_INTERVAL_SECONDS=5

# docker-compose.demo.yml overrides the internal URLs for API and worker containers.
VOICE_PROVIDER=local-openai-compatible-tts
VOICE_BASE_URL=http://localhost:8001
VOICE_API_KEY=demo-voice-token
VOICE_MODEL=piper-arabic
VOICE_TIMEOUT_SECONDS=300
VOICE_MAX_RETRIES=2

LIP_SYNC_PROVIDER=local-lip-sync-http
LIP_SYNC_BASE_URL=http://host.docker.internal:8090
LIP_SYNC_ENDPOINT_PATH=/v1/lip-sync
LIP_SYNC_API_KEY=demo-lip-sync-token
LIP_SYNC_TIMEOUT_SECONDS=2400

SOUND_PROVIDER=local-sound-http
SOUND_BASE_URL=http://localhost:8002
SOUND_ENDPOINT_PATH=/v1/audio/generate
SOUND_API_KEY=demo-sound-token
SOUND_TIMEOUT_SECONDS=300
SOUND_MAX_RETRIES=2
FFMPEG_BINARY=ffmpeg

CELERY_TASK_ALWAYS_EAGER=false
