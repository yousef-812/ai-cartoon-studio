{
  "workflow": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1,
        "steps": 30,
        "cfg": 6.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1,
        "model": ["14", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1280,
        "height": 720,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "animation production frame",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "text, watermark, deformed anatomy",
        "clip": ["4", 1]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ai_cartoon_studio_reference_guided",
        "images": ["8", 0]
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "reference-1.png"
      }
    },
    "11": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "reference-2.png"
      }
    },
    "12": {
      "class_type": "ImageBatch",
      "inputs": {
        "image1": ["10", 0],
        "image2": ["11", 0]
      }
    },
    "13": {
      "class_type": "IPAdapterUnifiedLoader",
      "inputs": {
        "model": ["4", 0],
        "preset": "PLUS (high strength)"
      }
    },
    "14": {
      "class_type": "IPAdapterAdvanced",
      "inputs": {
        "model": ["13", 0],
        "ipadapter": ["13", 1],
        "image": ["12", 0],
        "weight": 0.8,
        "weight_type": "linear",
        "combine_embeds": "average",
        "start_at": 0,
        "end_at": 0.8,
        "embeds_scaling": "K+V w/ C penalty"
      }
    }
  },
  "bindings": {
    "prompt": {"node_id": "6", "input_name": "text"},
    "negative_prompt": {"node_id": "7", "input_name": "text"},
    "width": {"node_id": "5", "input_name": "width"},
    "height": {"node_id": "5", "input_name": "height"},
    "seed": {"node_id": "3", "input_name": "seed"},
    "steps": {"node_id": "3", "input_name": "steps"},
    "guidance_scale": {"node_id": "3", "input_name": "cfg"},
    "reference_image_1": {"node_id": "10", "input_name": "image"},
    "reference_image_2": {"node_id": "11", "input_name": "image"}
  }
